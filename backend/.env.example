DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-app.up.railway.app
# Comma-separated if frontend is hosted separately:
# FRONTEND_URLS=https://app.example.com,https://www.example.com

# First deployment only. Set to false/remove after the first admin is created.
BOOTSTRAP_ADMIN=false
ADMIN_NAME=System Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_EMAIL=
DEFAULT_BRANCH_NAME=الفرع الرئيسي
DEFAULT_BRANCH_CODE=MAIN
